{
  "manifest_version": 3,
  "name": "hyde — hide the YouTube video player controls",
  "version": "1.4",
  "description": "Hide or show YouTube's video player controls with Ctrl+M or from the popup. Hides the play bar, big play button, watermark, and more.",
  "icons": {
    "16": "img/icon16.png",
    "32": "img/icon32.png",
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "16": "img/icon16.png",
      "32": "img/icon32.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "hyde — hide the YouTube video player controls"
  },
  "commands": {
    "hide": {
      "suggested_key": {
        "default": "Ctrl+M"
      },
      "description": "hide/show controls"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ]
}
